# Optional root-level overrides consumed by docker compose.
# Copy to .env (never commit) if you need to change ports or defaults.

BACKEND_PORT=8000
FRONTEND_PORT=8080

# Base URL the browser uses to reach the backend.
# Local Docker: http://localhost:8000
# Deployed:     your Render/Railway service URL, e.g. https://aeron-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

DATA_MODE=live
CACHE_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
