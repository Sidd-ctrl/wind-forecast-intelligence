# AERON frontend configuration
# Copy to frontend/.env for local development. Every Vite variable is public and
# is embedded in the client bundle. Never place secrets here.

# Backend base URL. Leave empty to use the same origin, which works with the
# Vite development proxy and with the Docker Compose reverse proxy.
# Local development against a separately started backend:
VITE_API_BASE_URL=http://localhost:8000

# Deployed example (use your own Render service URL):
# VITE_API_BASE_URL=https://aeron-api.onrender.com

# Only used by the Vite dev/preview proxy in local development.
VITE_PROXY_TARGET=http://127.0.0.1:8000
