# AERON backend configuration
# Copy to backend/.env for local development. Never commit the real .env file.

# live   : retrieve historical records from the Elexon BMRS Insights API
# sample : serve the bundled January 2026 snapshot with no network access
DATA_MODE=live

# Elexon BMRS Insights API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3
ELEXON_RETRY_BACKOFF_SECONDS=1.5
# The Elexon API rejects any single request spanning more than 7 days
ELEXON_MAX_CHUNK_DAYS=7

# Analysis window fixed by the assignment
ANALYSIS_START_DATE=2026-01-01
ANALYSIS_END_DATE=2026-01-31
FORECAST_PUBLISH_LOOKBACK_DAYS=7
FORECAST_PUBLISH_LOOKAHEAD_DAYS=2

# Default decision cutoff behaviour
DEFAULT_LEAD_HOURS=12
ALLOWED_LEAD_HOURS=4,8,12,24,36,48

# Filesystem cache. Point at a writable path; it is safe for this directory to be
# ephemeral because a cache miss simply re-downloads the January 2026 datasets.
CACHE_ENABLED=true
CACHE_DIR=/tmp/aeron-cache
CACHE_TTL_HOURS=24

# CORS: comma-separated exact origins plus a regex for Vercel preview deployments
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app

LOG_LEVEL=INFO
